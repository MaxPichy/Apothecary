{
  "name": "apotecary",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && pnpm dev",
    "dev:frontend": "cd frontend && pnpm dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "build:backend": "cd backend && pnpm build",
    "build:frontend": "cd frontend && pnpm build",
    "build": "pnpm build:backend && pnpm build:frontend",
    "lint": "cd backend && pnpm lint && cd ../frontend && pnpm lint",
    "typecheck": "cd backend && pnpm typecheck && cd ../frontend && pnpm typecheck",
    "format": "pnpm --filter backend format && pnpm --filter frontend format"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1"
  },
  "lint-staged": {
    "backend/**/*.{ts,js}": [
      "pnpm --filter backend exec eslint --fix",
      "pnpm --filter backend exec prettier --write"
    ],
    "frontend/**/*.{ts,tsx}": [
      "pnpm --filter frontend exec eslint --fix",
      "pnpm --filter frontend exec prettier --write"
    ]
  }
}